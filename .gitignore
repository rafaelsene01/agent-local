# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# fastembed drops its ONNX model here when no cache dir is set (tests do
# that). The app itself points the cache at the user's base folder.
src-tauri/.fastembed_cache/

# Updater signing keys. The PRIVATE key must never be committed — whoever has
# it (plus the password) can sign an update that every installed copy of the
# app will trust and install. It belongs in a password manager and in the
# TAURI_SIGNING_PRIVATE_KEY repository secret, nowhere else.
# The public key is not secret, but it lives in tauri.conf.json, not loose here.
*.key
*.key.pub
localmind.key*

# Binary components vendored into the installer by `npm run vendor`.
# ~120 MB of build artefact, pinned in scripts/vendor.json — not source.
#
# The contents are ignored, not the directory: `bundle.resources` names
# `resources/` and tauri-build fails the whole build when that path is missing.
# Ignoring `src-tauri/resources/` outright kept it out of a fresh checkout, and
# `cargo test` — which never goes through the Tauri CLI, so never runs the
# vendoring — died in the build script. Git cannot re-include a file whose
# parent directory is excluded, hence the `/*` form plus the .gitkeep exception.
src-tauri/resources/*
!src-tauri/resources/.gitkeep
