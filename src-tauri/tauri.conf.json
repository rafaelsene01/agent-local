{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalMind",
  "mainBinaryName": "LocalMind",
  "version": "../package.json",
  "identifier": "com.localmind.app",
  "build": {
    "beforeDevCommand": "npm run vendor && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vendor && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalMind",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/"
    ],
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5NEQxNEJFNjFGMDFBQjgKUldTNEd2Qmh2aFJONmJSUEt1eUhuQXpKM2R5U1M3OU44Yk1aQjVJVnlBVCtsUEIxdkVXeENjMG0K",
      "endpoints": [
        "https://github.com/rafaelsene01/local-mind/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}